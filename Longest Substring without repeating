class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        int maxlength = 0;
        for (int i = 0 ; i < s.size(); i++){
            string temp = "";
            for (int j = i; j < s.size()+1; j++){
                bool repeat = false;
                for (int k = 0; k < temp.size(); k++){
                    if (s[j] == temp[k]){
                        repeat = true;
                        break;
                    }
                }
                if (maxlength < temp.size()){
                    maxlength = temp.size();
                }
                temp += s[j];
                if (repeat){
                    break;
                }
            }
        }
        return maxlength;
    }
};
